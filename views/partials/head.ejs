<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : siteName %></title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="nav">
  <a class="brand" href="/">🏹 <%= siteName %></a>
  <div class="nav-links">
    <a href="/">首页</a>
    <a href="/about">关于我们</a>
    <a href="/board">动态墙</a>
    <a href="/logs">训练日志</a>
    <a href="/notices">通知</a>
    <% if (user) { %>
      <a class="nav-user" href="/u/<%= user.username %>">
        <% if (user.avatar) { %><img class="avatar-sm" src="<%= user.avatar %>" alt=""><% } else { %><span class="avatar-sm avatar-placeholder">🏹</span><% } %>
        <span class="who"><%= user.display_name %><% if (isAdmin) { %> · 管理员<% } %></span>
      </a>
      <a href="/settings">设置</a>
      <% if (isAdmin) { %><a href="/admin">工作台</a><% } %>
      <form method="post" action="/logout" class="inline"><button class="link-btn" type="submit">退出</button></form>
    <% } else { %>
      <a href="/login">登录</a>
      <a class="btn small" href="/register">注册</a>
    <% } %>
  </div>
</nav>
<main class="main">
