<% pageTitle = siteName + ' · 工作台'; %>
<%- include('partials/head') %>
<div class="admin-panel">
  <h1>工作台</h1>
  <p class="muted">只有管理员能进入。改完内容保存后即时生效。</p>
  <% if (ok) { %><p class="ok">已保存 ✓</p><% } %>

  <section>
    <h2>编辑网站内容</h2>
    <form method="post" action="/admin/content">
      <div class="admin-field">
        <label>首页小标题</label>
        <input name="eyebrow" value="<%= content.hero.eyebrow %>">
      </div>
      <div class="admin-field">
        <label>首页说明文字</label>
        <textarea name="lead" rows="3"><%= content.hero.lead %></textarea>
      </div>
      <div class="admin-field">
        <label>首页公告（可留空）</label>
        <textarea name="announcement" rows="3"><%= content.announcement %></textarea>
      </div>
      <div class="admin-field">
        <label>关于我们</label>
        <textarea name="about" rows="6"><%= content.about %></textarea>
      </div>
      <button class="btn" type="submit">保存内容</button>
    </form>
  </section>

  <section>
    <h2>注册审批</h2>
    <% if (!pendingUsers.length) { %>
      <p class="muted">没有待审批的申请。</p>
    <% } else { %>
      <table class="user-table">
        <thead><tr><th>用户名</th><th>邮箱</th><th>申请理由</th><th>申请时间</th><th>操作</th></tr></thead>
        <tbody>
          <% pendingUsers.forEach(u => { %>
          <tr>
            <td><%= u.username %></td>
            <td class="muted"><%= u.email || '—' %></td>
            <td><%= u.reason %></td>
            <td class="muted"><%= u.created_at %></td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>/approve" class="inline">
                <button class="btn small" type="submit">通过</button>
              </form>
              <form method="post" action="/admin/users/<%= u.id %>/reject" class="inline" onsubmit="return confirm('确定不通过该申请？')">
                <button class="btn small ghost" type="submit">不通过</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section>
    <h2>成员管理（指定管理员 / 删除成员）</h2>
    <table class="user-table">
      <thead><tr><th>用户名</th><th>昵称</th><th>角色</th><th>注册时间</th><th>操作</th></tr></thead>
      <tbody>
        <% users.forEach(u => { %>
        <tr>
          <td><%= u.username %><% if (user && u.id === user.id) { %> <span class="muted">（我）</span><% } %></td>
          <td><a class="post-user" href="/u/<%= u.username %>"><%= u.nickname || u.username %></a></td>
          <td><span class="badge <%= u.role %>"><%= u.role === 'admin' ? '管理员' : '成员' %></span></td>
          <td class="muted"><%= u.created_at %></td>
          <td>
            <% if (user && u.id !== user.id) { %>
              <form method="post" action="/admin/users/<%= u.id %>/role" class="inline">
                <% if (u.role === 'admin') { %>
                  <input type="hidden" name="role" value="member">
                  <button class="link-btn" type="submit">取消管理员</button>
                <% } else { %>
                  <input type="hidden" name="role" value="admin">
                  <button class="btn small" type="submit">设为管理员</button>
                <% } %>
              </form>
              <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline" onsubmit="return confirm('确定删除该成员？其动态、评论、弹幕等数据将一并删除。')">
                <button class="link-btn del" type="submit">删除</button>
              </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <% if (rejectedUsers.length) { %>
  <section>
    <h2>已拒绝的申请</h2>
    <table class="user-table">
      <thead><tr><th>用户名</th><th>邮箱</th><th>申请理由</th><th>操作</th></tr></thead>
      <tbody>
        <% rejectedUsers.forEach(u => { %>
        <tr>
          <td><%= u.username %></td>
          <td class="muted"><%= u.email || '—' %></td>
          <td><%= u.reason %></td>
          <td>
            <form method="post" action="/admin/users/<%= u.id %>/approve" class="inline">
              <button class="btn small" type="submit">改为通过</button>
            </form>
            <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline" onsubmit="return confirm('确定删除该申请？')">
              <button class="link-btn del" type="submit">删除</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <section>
    <h2>动态管理</h2>
    <% if (!posts.length) { %>
      <p class="muted">还没有任何动态。</p>
    <% } else { %>
      <ul class="posts">
        <% posts.forEach(p => { %>
          <li class="post">
            <div class="post-meta">
              <span class="post-user"><%= p.display_name %></span>
              <span class="post-time"><%= p.created_at %></span>
            </div>
            <p class="post-content"><%= p.content %></p>
            <% if (p.image) { %><img class="post-image" src="<%= p.image %>" alt=""><% } %>
            <form method="post" action="/admin/posts/<%= p.id %>/delete" class="inline">
              <button class="link-btn del" type="submit">删除</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section>
    <h2>日志管理</h2>
    <p><a class="btn small" href="/logs/new">＋ 创建日志</a></p>
    <% if (!logs.length) { %>
      <p class="muted">还没有日志。</p>
    <% } else { %>
      <ul class="posts">
        <% logs.forEach(l => { %>
          <li class="post">
            <div class="post-meta">
              <span class="post-user"><%= l.title %></span>
              <span class="post-time"><%= l.created_at %></span>
            </div>
            <p class="muted"><%= l.display_name %> 发布<% if (l.video_url) { %> · 含视频<% } %></p>
            <p>
              <a class="link-btn" href="/logs/<%= l.id %>/edit">编辑</a>
              <form method="post" action="/logs/<%= l.id %>/delete" class="inline" onsubmit="return confirm('确定删除这篇日志？')">
                <button class="link-btn del" type="submit">删除</button>
              </form>
            </p>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
<%- include('partials/foot') %>
